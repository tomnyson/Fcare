// FCare — Prisma schema
//
// NGUYÊN TẮC BẢO MẬT (từ tài liệu nghiệp vụ — TUYỆT ĐỐI tuân thủ):
// - CẤM lưu CCCD/CMND, số điện thoại, email, địa chỉ của sinh viên và nhân viên/giảng viên.
// - Giảng viên chỉ quản lý sinh viên thuộc bộ môn mình (scoping ở tầng service).
// - Không có email trong DB → reset mật khẩu qua mật khẩu tạm do admin cấp.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== Tổ chức =====

model Department {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  // Bộ môn cơ sở không mở: tắt để ẩn khỏi danh mục + dropdown. Môn học của bộ
  // môn tắt cũng ẩn theo (suy ra, không lưu cờ riêng) → bật lại là hiện lại.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  majors   Major[]
  subjects Subject[]
  staff    Staff[]
  students Student[]
  aliases  DepartmentAlias[]

  @@map("departments")
}

model Major {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department      Department       @relation(fields: [departmentId], references: [id])
  students        Student[]
  classMajorRules ClassMajorRule[]
  aliases         MajorAlias[]

  @@map("majors")
}

model Subject {
  id           String   @id @default(uuid())
  code         String   @unique
  name         String
  credits      Int
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subjectGroup           String?
  hoursTotal             Int?
  learningMethod         String? // TRA | BLE | ONL
  maxStudents            Int?
  examForm               String?
  attendanceRateRequired Float? // file lưu dạng tỉ lệ 0.8, KHÔNG phải 80

  department    Department     @relation(fields: [departmentId], references: [id])
  classSections ClassSection[]

  @@map("subjects")
}

// Lớp học phần: môn học + giảng viên + học kỳ
model ClassSection {
  id           String    @id @default(uuid())
  code         String
  subjectId    String
  lecturerId   String? // nullable: 76/94 lớp trong file nguồn chưa phân công GV
  term         String // vd: "SU25"
  block        Int? // 1 | 2
  slot         String? // ca học, vd "S1".."S6"
  weekdays     String? // mã thứ, vd "246" | "357"
  room         String?
  capacity     Int?
  trainingTime String? // AM | PM | EV
  startDate    DateTime?
  totalHours   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  subject     Subject      @relation(fields: [subjectId], references: [id])
  lecturer    Staff?       @relation(fields: [lecturerId], references: [id])
  enrollments Enrollment[]
  evaluations Evaluation[]
  alerts      Alert[]
  careLogs    CareLog[]

  @@unique([code, term])
  @@map("class_sections")
}

// ===== Nhân sự & phân quyền =====

// Chỉ lưu: mã NV, họ tên, bộ môn. KHÔNG email/SĐT/địa chỉ/CCCD.
model Staff {
  id                 String   @id @default(uuid())
  staffCode          String   @unique // mã nhân viên — dùng để đăng nhập
  fullName           String
  email              String?
  departmentId       String?
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  isActive           Boolean  @default(true)
  username           String?  @unique // username nội bộ từ file phân công, KHÔNG phải email
  lecturerType       String? // FULL | PART
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  department                    Department?                    @relation(fields: [departmentId], references: [id])
  roles                         StaffRole[]
  consentLogs                   ConsentLog[]
  refreshTokens                 RefreshToken[]
  classSections                 ClassSection[]
  evaluations                   Evaluation[]
  ownedTermAnalyses             StudentTermAnalysis[]          @relation("StudentTermAnalysisOwner")
  createdTermAnalysisVersions   StudentTermAnalysisVersion[]   @relation("StudentTermAnalysisVersionCreatedBy")
  reviewedTermAnalysisVersions  StudentTermAnalysisVersion[]   @relation("StudentTermAnalysisVersionReviewedBy")
  dismissedTermAnalysisVersions StudentTermAnalysisVersion[]   @relation("StudentTermAnalysisVersionDismissedBy")
  termAnalysisRecipients        StudentTermAnalysisRecipient[]
  careLogs                      CareLog[]
  raisedAlerts                  Alert[]                        @relation("AlertRaisedBy")
  resolvedAlerts                Alert[]                        @relation("AlertResolvedBy")
  notifications                 Notification[]
  auditLogs                     AuditLog[]
  importBatches                 ImportBatch[]
  discussionMessages            DiscussionMessage[]
  discussionReads               DiscussionRead[]
  oauthIdentities               StaffOAuthIdentity[]
  mailSettingsUpdated           MailSetting[]                  @relation("MailSettingUpdatedBy")
  monitoringSettingsUpdated     MonitoringSetting[]            @relation("MonitoringSettingUpdatedBy")

  @@map("staff")
}

model StaffOAuthIdentity {
  id        String   @id @default(uuid())
  staffId   String
  provider  String
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([staffId, provider])
  @@map("staff_oauth_identities")
}

/// Cấu hình SMTP toàn hệ thống — đúng 1 dòng (`id = 'default'`).
/// `passwordEncrypted` là ciphertext AES-256-GCM (xem common/utils/secret-cipher.ts),
/// KHÔNG bao giờ trả ra API.
model MailSetting {
  id                String    @id @default("default")
  host              String
  port              Int       @default(587)
  secure            Boolean   @default(false)
  username          String?
  passwordEncrypted String?   @map("password_encrypted")
  fromName          String    @map("from_name")
  fromEmail         String    @map("from_email")
  enabled           Boolean   @default(true)
  lastTestedAt      DateTime? @map("last_tested_at")
  lastTestOk        Boolean?  @map("last_test_ok")
  updatedById       String?   @map("updated_by_id")
  updatedBy         Staff?    @relation("MailSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("mail_settings")
}

// ===== Giám sát lỗi hệ thống =====

/// Nhóm lỗi hệ thống theo tuần (thứ Hai 00:00 giờ VN). Lỗi giống nhau cộng dồn `count`
/// thay vì mỗi lần một dòng. `message`/`stack` ĐÃ che PII trước khi ghi (sanitize-log-text.ts).
model SystemErrorGroup {
  id          String            @id @default(uuid())
  fingerprint String
  weekStart   DateTime          @map("week_start")
  level       SystemErrorLevel
  source      SystemErrorSource
  context     String?
  route       String?
  statusCode  Int?              @map("status_code")
  message     String
  stack       String?
  count       Int               @default(1)
  firstSeenAt DateTime          @map("first_seen_at")
  lastSeenAt  DateTime          @map("last_seen_at")

  @@unique([fingerprint, weekStart])
  @@index([weekStart, count])
  @@index([lastSeenAt])
  @@map("system_error_groups")
}

enum SystemErrorLevel {
  ERROR
  FATAL
}

enum SystemErrorSource {
  HTTP
  QUEUE
  PROCESS
  APP
}

/// Cấu hình giám sát (singleton `id = "default"`). URL webhook Discord mã hoá AES-256-GCM,
/// KHÔNG bao giờ trả ra API; chưa có dòng → fallback env `DISCORD_WEBHOOK_URL`.
model MonitoringSetting {
  id                  String    @id @default("default")
  webhookUrlEncrypted String?   @map("webhook_url_encrypted")
  enabled             Boolean   @default(true)
  retentionDays       Int       @default(30) @map("retention_days")
  lastReportAt        DateTime? @map("last_report_at")
  lastReportOk        Boolean?  @map("last_report_ok")
  updatedById         String?   @map("updated_by_id")
  updatedBy           Staff?    @relation("MonitoringSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  @@map("monitoring_settings")
}

model Role {
  id   String @id @default(uuid())
  key  String @unique // ADMIN | HEAD_OF_DEPT | LECTURER | TRAINING_OFFICER | SA_OFFICER | SA_HEAD
  name String

  staff StaffRole[]

  @@map("roles")
}

model StaffRole {
  staffId String
  roleId  String

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([staffId, roleId])
  @@map("staff_roles")
}

// Cam kết không chia sẻ dữ liệu — bắt buộc mỗi lần đăng nhập
model ConsentLog {
  id          String   @id @default(uuid())
  staffId     String
  consentedAt DateTime @default(now())
  userAgent   String?

  staff         Staff          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@map("consent_logs")
}

model RefreshToken {
  id           String     @id @default(uuid())
  staffId      String
  tokenHash    String     @unique
  consentLogId String?
  /// Cách đăng nhập của phiên — xoay token vẫn giữ nguyên. GOOGLE không bị bắt đổi mật khẩu tạm.
  authMethod   AuthMethod @default(PASSWORD)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  staff      Staff       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  consentLog ConsentLog? @relation(fields: [consentLogId], references: [id])

  @@map("refresh_tokens")
}

enum AuthMethod {
  PASSWORD
  GOOGLE
}

model AuditLog {
  id        String   @id @default(uuid())
  staffId   String?
  action    String // vd: EXCEL_IMPORT_STUDENTS, EXCEL_EXPORT_GRADES, RESET_PASSWORD
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  staff Staff? @relation(fields: [staffId], references: [id])

  @@index([action, createdAt])
  @@map("audit_logs")
}

// ===== Sinh viên & học vụ =====

enum StudentStatus {
  STUDYING // đang học
  RESERVED // bảo lưu
  WARNED // cảnh báo học vụ
  DROPPED_OUT // thôi học
  GRADUATED // tốt nghiệp
}

// Chỉ lưu: MSSV, họ tên, ngày sinh, giới tính, ngành, khóa, lớp, trạng thái.
// KHÔNG CCCD/SĐT/email/địa chỉ.
model Student {
  id           String        @id @default(uuid())
  studentCode  String        @unique // MSSV
  fullName     String
  dateOfBirth  DateTime?
  gender       String?
  majorId      String? // nullable: SV chờ admin gán ngành
  departmentId String // denormalized từ major — phục vụ scoping theo bộ môn
  cohort       String? // khóa, vd: "K19" — nullable: không suy được từ mã lớp học phần
  classCode    String // lớp hành chính, vd: "SE1901"
  status       StudentStatus @default(STUDYING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  major              Major?                @relation(fields: [majorId], references: [id])
  department         Department            @relation(fields: [departmentId], references: [id])
  enrollments        Enrollment[]
  evaluations        Evaluation[]
  termAnalyses       StudentTermAnalysis[]
  careLogs           CareLog[]
  alerts             Alert[]
  discussionMessages DiscussionMessage[]
  discussionReads    DiscussionRead[]

  @@index([departmentId])
  @@index([classCode])
  @@map("students")
}

enum EnrollmentResult {
  IN_PROGRESS
  PASS
  FAIL
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String
  classSectionId String
  attendanceRate Float? // 0..100
  absentSessions Int? // số buổi đã nghỉ (cột "Số buổi nghỉ/TS")
  totalSessions  Int? // tổng số buổi của lớp học phần
  midtermScore   Float? // 0..10
  finalScore     Float? // 0..10
  totalScore     Float? // 0..10
  isExamBanned   Boolean          @default(false)
  result         EnrollmentResult @default(IN_PROGRESS)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  @@unique([studentId, classSectionId])
  @@map("enrollments")
}

// ===== Chăm sóc & cảnh báo =====

// Đánh giá SV: học lực 1-10, thái độ 1-10, nhóm vấn đề 1-4
// Tiêu chí nhận xét theo tài liệu II.2 mục 3 (R_P) và mục 4 (R_H).
// Tên thành viên phải trùng `EvaluationCriterion` trong @fcare/shared-types.
enum EvaluationCriterion {
  P_NOT_FIT_MAJOR
  P_PART_TIME_JOB
  P_OTHER_ACTIVITIES
  P_FAMILY_HARDSHIP
  P_FINANCIAL_HARDSHIP
  P_PSYCHOLOGICAL
  P_DROPOUT_INTENT
  H_NO_QUIZ_CMS
  H_EXAM_BAN_RISK
  H_NO_RESPONSE
}

// Nhận xét của MỘT giảng viên cho MỘT sinh viên ở MỘT lớp học phần.
model Evaluation {
  id             String   @id @default(uuid())
  studentId      String
  lecturerId     String
  classSectionId String
  term           String
  academicScore  Int // 1..10 → R_L
  attitudeScore  Int // 1..10 → R_A
  absentSessions Int? // số buổi vắng GV ghi nhận → R_C; null = chưa nhận xét chuyên cần
  note           String? // nhận xét chữ — đầu vào cho AI xét ép cấp độ
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student                   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  lecturer     Staff                     @relation(fields: [lecturerId], references: [id])
  classSection ClassSection              @relation(fields: [classSectionId], references: [id])
  criteria     EvaluationCriterionMark[]

  @@unique([lecturerId, classSectionId, studentId])
  @@index([studentId, term])
  @@map("evaluations")
}

model EvaluationCriterionMark {
  id           String              @id @default(uuid())
  evaluationId String
  criterion    EvaluationCriterion

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, criterion])
  @@map("evaluation_criteria")
}

enum CareChannel {
  IN_PERSON // gặp trực tiếp
  ONLINE // trao đổi online qua kênh nội bộ
}

model CareLog {
  id             String      @id @default(uuid())
  studentId      String
  staffId        String
  channel        CareChannel
  content        String
  outcome        String?
  nextAction     String?
  /// Nhật ký này là phản hồi cho cảnh báo nào (tuỳ chọn). Với cảnh báo điểm danh:
  /// staff == classSection.lecturerId → tắt cảnh báo "liên tục" của GV đó.
  alertId        String?
  /// Lớp học phần đang chăm sóc — cho biết học kỳ + môn học của lượt trao đổi.
  /// Null với nhật ký cũ (trước khi có trường này).
  classSectionId String?
  createdAt      DateTime    @default(now())

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff        Staff         @relation(fields: [staffId], references: [id])
  alert        Alert?        @relation(fields: [alertId], references: [id], onDelete: SetNull)
  classSection ClassSection? @relation(fields: [classSectionId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([alertId])
  @@index([classSectionId])
  @@map("care_logs")
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

/// Nguồn phát cảnh báo: người bấm gửi (MANUAL) hay hệ thống rà soát điểm danh
/// sau import GRADE_ATTENDANCE (AUTO_ATTENDANCE — FLOW 2 module chăm sóc).
/// Kết quả chốt cảnh báo: Đạt, hoặc đã chăm sóc nhưng vẫn cấm thi / rớt môn.
enum AlertOutcome {
  PASSED
  EXAM_BANNED
  FAILED
}

enum AlertSource {
  MANUAL
  AUTO_ATTENDANCE
}

// Cảnh báo mức độ khẩn 1-4; mức 4 yêu cầu lý do >= 40 ký tự (validate tầng DTO)
model Alert {
  id             String        @id @default(uuid())
  studentId      String
  /// null khi hệ thống tự phát (source = AUTO_ATTENDANCE) — UI hiện "Hệ thống".
  raisedById     String?
  level          Int // 1..4
  reason         String
  status         AlertStatus   @default(OPEN)
  source         AlertSource   @default(MANUAL)
  /// Lớp học phần phát sinh cảnh báo điểm danh; GV đứng lớp này bị "đeo" cảnh báo
  /// liên tục cho tới khi chính họ ghi CareLog gắn alertId (ownerCaredAt).
  classSectionId String?
  term           String?
  absentSessions Int?
  ownerCaredAt   DateTime?
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  /// null với cảnh báo chốt trước khi có trường này.
  outcome        AlertOutcome?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  student          Student                      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  raisedBy         Staff?                       @relation("AlertRaisedBy", fields: [raisedById], references: [id])
  resolvedBy       Staff?                       @relation("AlertResolvedBy", fields: [resolvedById], references: [id])
  classSection     ClassSection?                @relation(fields: [classSectionId], references: [id], onDelete: SetNull)
  notifications    Notification[]
  analysisVersions StudentTermAnalysisVersion[]
  careLogs         CareLog[]

  @@index([studentId, status])
  @@index([level, status])
  @@index([source, status, classSectionId])
  @@index([studentId, classSectionId, term])
  @@map("alerts")
}

model Notification {
  id                  String    @id @default(uuid())
  recipientId         String
  alertId             String?
  analysisVersionId   String?
  discussionMessageId String?
  title               String
  body                String
  targetUrl           String?
  readAt              DateTime?
  createdAt           DateTime  @default(now())

  recipient         Staff                         @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  // Cascade: ADMIN xoá cảnh báo thì thông báo đã phát (mang tên + mã SV + lý do)
  // phải chết theo, không để lại dòng mồ côi không còn cách dọn.
  alert             Alert?                        @relation(fields: [alertId], references: [id], onDelete: Cascade)
  analysisVersion   StudentTermAnalysisVersion?   @relation(fields: [analysisVersionId], references: [id], onDelete: SetNull)
  // HIGH-A: Cascade chứ KHÔNG SetNull. `discussion_messages.studentId` là
  // Cascade, nên xoá sinh viên là xoá tin; SetNull sẽ để lại dòng thông báo
  // mang 120 ký tự nội dung cán bộ gõ, mất con trỏ về tin — và bộ tẩy khi thu
  // hồi khoá theo đúng cột vừa bị NULL nên không bao giờ với tới được nữa.
  discussionMessage DiscussionMessage?            @relation(fields: [discussionMessageId], references: [id], onDelete: Cascade)
  analysisRecipient StudentTermAnalysisRecipient? @relation("AnalysisRecipientNotification")

  // Idempotency cho queue escalation: retry không tạo trùng thông báo cùng cảnh báo.
  @@unique([alertId, recipientId])
  @@unique([analysisVersionId, recipientId])
  @@unique([discussionMessageId, recipientId])
  @@index([recipientId, readAt])
  @@index([recipientId, createdAt(sort: Desc)])
  @@map("notifications")
}

/**
 * Nội dung thực sự được gửi đi: bản AI tổng hợp hay bản giảng viên tự soạn.
 */
enum AnalysisContentSource {
  AI
  LECTURER
}

enum StudentTermAnalysisStatus {
  QUEUED
  GENERATING
  DRAFT
  FAILED
  SUPERSEDED
  SEND_QUEUED
  SENT
}

model StudentTermAnalysis {
  id        String   @id @default(uuid())
  studentId String
  term      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student  Student                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  owner    Staff                        @relation("StudentTermAnalysisOwner", fields: [ownerId], references: [id])
  versions StudentTermAnalysisVersion[]

  @@unique([studentId, term])
  @@index([ownerId])
  @@map("student_term_analyses")
}

model StudentTermAnalysisVersion {
  id                String                    @id @default(uuid())
  analysisId        String
  version           Int
  status            StudentTermAnalysisStatus @default(QUEUED)
  idempotencyKey    String                    @unique
  // Bản do hệ thống tự sinh sau khi giảng viên lưu nhận xét: sinh xong thì hỏi
  // người vừa nhận xét có gửi hay không, không tự gửi.
  needsSendDecision Boolean                   @default(false)
  sourceSnapshot    Json
  sourceHash        String
  aiOriginal        Json?
  editedOutput      Json?
  model             String
  promptVersion     String
  inputTokens       Int?
  outputTokens      Int?
  reasoningTokens   Int?
  totalTokens       Int?
  errorMessage      String?
  // Nguồn nội dung đã gửi; null = chưa gửi.
  contentSource     AnalysisContentSource?
  // Nội dung giảng viên tự soạn (đã lọc PII) khi chọn không dùng bản AI.
  lecturerNote      String?
  createdById       String
  reviewedById      String?
  // Người bấm "Không gửi" cho bản gợi ý — bản nháp vẫn còn để gửi tay sau.
  dismissedById     String?
  dismissedAt       DateTime?
  alertId           String?
  requestedAt       DateTime                  @default(now())
  generatedAt       DateTime?
  editedAt          DateTime?
  reviewedAt        DateTime?
  sentAt            DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  analysis      StudentTermAnalysis            @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  createdBy     Staff                          @relation("StudentTermAnalysisVersionCreatedBy", fields: [createdById], references: [id])
  reviewedBy    Staff?                         @relation("StudentTermAnalysisVersionReviewedBy", fields: [reviewedById], references: [id])
  dismissedBy   Staff?                         @relation("StudentTermAnalysisVersionDismissedBy", fields: [dismissedById], references: [id])
  // Cảnh báo sinh ra lúc gửi bản phân tích. Giữ ở version để job giao hàng chạy
  // sau (BullMQ) vẫn gắn được thông báo vào đúng cảnh báo.
  alert         Alert?                         @relation(fields: [alertId], references: [id], onDelete: SetNull)
  recipients    StudentTermAnalysisRecipient[]
  notifications Notification[]

  @@unique([analysisId, version])
  @@index([analysisId, status])
  @@index([createdById])
  @@index([reviewedById])
  @@index([dismissedById])
  @@index([alertId])
  @@map("student_term_analysis_versions")
}

model StudentTermAnalysisRecipient {
  id                    String    @id @default(uuid())
  versionId             String
  recipientId           String
  recipientStaffCode    String
  recipientFullName     String
  recipientDepartmentId String?
  notificationId        String?   @unique
  openedAt              DateTime?
  createdAt             DateTime  @default(now())

  version      StudentTermAnalysisVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  recipient    Staff                      @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  notification Notification?              @relation("AnalysisRecipientNotification", fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([versionId, recipientId])
  @@index([recipientId, openedAt])
  @@map("student_term_analysis_recipients")
}

// ===== Ánh xạ danh mục từ file nguồn =====

// Hai file nguồn dùng hai hệ mã bộ môn khác nhau ("CONG-NGHE-THONG-TIN" vs "CNTT").
// Bảng này để admin tự sửa ánh xạ mà không phải đụng code.
model DepartmentAlias {
  id           String   @id @default(uuid())
  alias        String   @unique
  departmentId String
  createdAt    DateTime @default(now())

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@map("department_aliases")
}

// Ánh xạ mã ngành trong file Excel về Major: "CHNA" → ngành Ngôn ngữ Trung.
// Không đoán ngành khi thiếu alias — import trả về unmappedAliases để admin khai báo.
model MajorAlias {
  id        String   @id @default(uuid())
  alias     String   @unique
  majorId   String
  createdAt DateTime @default(now())

  major Major @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@map("major_aliases")
}

// Suy ngành từ tiền tố mã lớp hành chính: "AI21301" → ngành LTAI.
model ClassMajorRule {
  id          String   @id @default(uuid())
  classPrefix String   @unique
  majorId     String
  createdAt   DateTime @default(now())

  major Major @relation(fields: [majorId], references: [id], onDelete: Cascade)

  @@map("class_major_rules")
}

// ===== Staging import Excel =====

enum ImportKind {
  CATALOG
  LECTURER
  SCHEDULE
  GRADEBOOK
  // Bộ file nhà trường gửi đầu kỳ (docs/tailieu/). Chạy đúng thứ tự:
  // SECTION_LIST → ROSTER → GRADE_ATTENDANCE.
  SECTION_LIST
  ROSTER
  GRADE_ATTENDANCE
}

enum ImportStatus {
  PENDING
  COMMITTED
  FAILED
  CANCELLED
}

model ImportBatch {
  id           String       @id @default(uuid())
  kind         ImportKind
  status       ImportStatus @default(PENDING)
  fileName     String
  term         String
  uploadedById String
  summary      Json // { toCreate, toUpdate, errorCount, warnings, unmappedAliases, unmappedMajorAliases }
  createdAt    DateTime     @default(now())
  committedAt  DateTime?

  uploadedBy Staff       @relation(fields: [uploadedById], references: [id])
  rows       ImportRow[]

  @@index([kind, status])
  @@map("import_batches")
}

model ImportRow {
  id       String  @id @default(uuid())
  batchId  String
  sheet    String
  rowIndex Int
  payload  Json // dữ liệu đã parse + chuẩn hoá — KHÔNG BAO GIỜ chứa PII
  error    String?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("import_rows")
}

/// Một tin nhắn trong luồng trao đổi của MỘT sinh viên.
/// Không có bảng thread/participant: `studentId` chính là định danh luồng, và
/// quyền đọc luồng đúng bằng `studentScope(user)` (RULE 2) — không có cơ chế mời.
/// Khác `CareLog` (biên bản chăm sóc chính thức, một chiều, có outcome/nextAction):
/// đây là trao đổi nội bộ giữa cán bộ với nhau, KHÔNG phải hồ sơ chăm sóc.
model DiscussionMessage {
  id        String    @id @default(uuid())
  studentId String
  authorId  String
  body      String
  deletedAt DateTime? // thu hồi mềm: giữ vết, UI hiện "tin nhắn đã thu hồi"
  createdAt DateTime  @default(now())

  student       Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  author        Staff          @relation(fields: [authorId], references: [id])
  notifications Notification[]

  @@index([studentId, createdAt])
  @@map("discussion_messages")
}

/// Mốc đã đọc của một cán bộ trong một luồng. Có hàng ở đây = đã tham gia luồng,
/// nên cũng là căn cứ xác định người nhận thông báo khi có tin mới.
model DiscussionRead {
  studentId  String
  staffId    String
  lastReadAt DateTime

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  staff   Staff   @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@id([studentId, staffId])
  @@map("discussion_reads")
}

// ===== Danh mục Học kỳ =====

enum TermSeason {
  SPRING
  SUMMER
  FALL
}

model Term {
  id                String     @id @default(uuid())
  code              String     @unique // vd: "SP25", "SU25", "FA25"
  name              String // vd: "Spring 2025"
  season            TermSeason
  year              Int // vd: 2025
  startDate         DateTime
  endDate           DateTime
  isCurrentOverride Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([startDate, endDate])
  @@map("terms")
}
