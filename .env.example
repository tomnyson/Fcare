# --- Database ---
# Port phải khớp POSTGRES_PORT/REDIS_PORT trong infra/docker/.env (mặc định 5432/6379).
# Nếu máy đã có Postgres/Redis khác chiếm port, đổi cả hai nơi cho khớp.
DATABASE_URL=postgresql://fcare:fcare@localhost:5432/fcare?schema=public

# --- Redis (queue + realtime adapter) ---
REDIS_URL=redis://localhost:6379

# --- AI analysis (disabled by default) ---
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- API ---
API_PORT=3001
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- SMTP (dev: mailhog) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=fcare-noreply@fpt.edu.vn
