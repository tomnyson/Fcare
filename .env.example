# --- Database ---
# Port phải khớp POSTGRES_PORT/REDIS_PORT trong infra/docker/.env (mặc định 5432/6379).
# Nếu máy đã có Postgres/Redis khác chiếm port, đổi cả hai nơi cho khớp.
DATABASE_URL=postgresql://fcare:fcare@localhost:5432/fcare?schema=public

# --- Redis (queue + realtime adapter) ---
REDIS_URL=redis://localhost:6379

# --- AI analysis (disabled by default) ---
AI_ANALYSIS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
AI_PROVIDER=openai
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- API ---
API_PORT=3001
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Web ---
# Phải kèm hậu tố /api — apiFetch gọi thẳng vào URL này (xem apps/web/src/lib/api.ts).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Push trình duyệt (OneSignal) — bỏ trống thì tắt tính năng ---
# Web: App ID (công khai). API: App ID + REST API Key (bí mật, dạng os_v2_…).
NEXT_PUBLIC_ONESIGNAL_APP_ID=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# Link Google Form góp ý / báo lỗi (nút nổi góc phải). Bỏ trống = form mặc định; chỉ nhận https.
NEXT_PUBLIC_FEEDBACK_FORM_URL=

# Bugsnag (theo dõi lỗi + hiệu năng web). Bỏ trống = tắt. Chỉ gửi khi release stage là production/staging.
NEXT_PUBLIC_BUGSNAG_API_KEY=
# Ghi đè release stage (mặc định = NODE_ENV); đặt staging để thử gửi từ máy dev.
NEXT_PUBLIC_BUGSNAG_RELEASE_STAGE=
# Phiên bản hiển thị trên Bugsnag (vd git sha), tuỳ chọn.
NEXT_PUBLIC_APP_VERSION=

# --- SMTP (dev: mailhog) — chỉ là fallback; ADMIN cấu hình thật tại /admin/mail ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=FCare — Chăm sóc & Giám sát Học vụ
SMTP_FROM=fcare-noreply@fpt.edu.vn
# Khoá mã hoá bí mật cấu hình (mật khẩu SMTP lưu DB). 32 byte hex: `openssl rand -hex 32`
# Đổi khoá = mọi mật khẩu đã lưu không giải mã được → phải nhập lại ở /admin/mail.
SETTINGS_ENCRYPTION_KEY=
