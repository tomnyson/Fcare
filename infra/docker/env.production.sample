# Mẫu biến môi trường cho stack production.
#
#   cp env.production.sample .env.production
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# File .env.production KHÔNG được commit (.gitignore đã chặn .env.*).
# Sinh secret: openssl rand -base64 32

# --- Domain ---
# Origin thật của web, không có dấu / ở cuối. Web sẽ gọi API tại <origin>/api.
PUBLIC_WEB_ORIGIN=https://fcare.example.com
TZ=Asia/Ho_Chi_Minh

# --- Postgres ---
POSTGRES_USER=fcare
POSTGRES_PASSWORD=doi-mat-khau-nay
POSTGRES_DB=fcare
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- JWT (bắt buộc đổi, mỗi chuỗi >= 32 ký tự ngẫu nhiên) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- AI phân tích học tập ---
AI_ANALYSIS_ENABLED=true
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Push trình duyệt (OneSignal). App ID dùng cho cả API lẫn build web; đổi App ID = build lại image web.
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
# reCAPTCHA v2 ô tick khi đăng nhập (bỏ trống cả hai = tắt). Site key inline lúc build web; đổi = build lại image web.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Email ---
# ADMIN cấu hình máy chủ SMTP thật trong giao diện: Hệ thống → Cấu hình email (/admin/mail).
# Các biến SMTP_* dưới đây chỉ là fallback khi DB chưa có cấu hình.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=FCare — Chăm sóc & Giám sát Học vụ
SMTP_FROM=fcare-noreply@fpt.edu.vn
# BẮT BUỘC: khoá mã hoá mật khẩu SMTP lưu trong DB — 32 byte hex: openssl rand -hex 32
# Đổi/mất khoá = mọi mật khẩu đã lưu không giải mã được, ADMIN phải nhập lại ở /admin/mail.
SETTINGS_ENCRYPTION_KEY=

# Giám sát lỗi: báo cáo tuần lên Discord (thứ Hai 08:00 giờ VN). ADMIN nên lưu
# webhook tại /admin/monitoring (mã hoá bằng SETTINGS_ENCRYPTION_KEY); biến này
# chỉ là fallback. Dạng https://discord.com/api/webhooks/<id>/<token>.
DISCORD_WEBHOOK_URL=
